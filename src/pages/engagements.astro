---
import Base from '../layouts/Base.astro';
import EngagementCarousel from '../components/EngagementCarousel.astro';
import { getCollection } from 'astro:content';

// Engagements are sourced from src/content/engagements/*.json (see
// src/content/config.ts). Filename-less `id` is the carousel anchor, e.g.
// eng-001. We keep downstream shape identical to the previous inline array
// so EngagementCarousel.astro did not need a signature change.
const engagementEntries = await getCollection('engagements');
const engagements = engagementEntries
  .map((entry) => ({
    id: entry.id,
    href: `/engagements/${entry.id}/`,
    num: entry.data.num,
    classification: entry.data.classification,
    sector: entry.data.sector,
    accent: entry.data.accent,
    statValue: entry.data.statValue,
    statLabel: entry.data.statLabel,
    leads: entry.data.leads,
    highlights: entry.data.highlights,
    _sort: entry.data.sort ?? Number.parseInt(entry.data.num, 10),
  }))
  .sort((a, b) => a._sort - b._sort || a.num.localeCompare(b.num))
  .map(({ _sort: _unused, ...rest }) => rest);

/**
 * Count-derived copy.
 *
 * The hero line and meta description used to hardcode "Six engagements
 * across six sectors". Adding or removing a dossier silently made both
 * statements false, and the meta description is length-gated by
 * scripts/check-meta-descriptions.mjs (110–180 chars), so drifting copy
 * could also break the build in a way that looks unrelated to the edit.
 * Deriving from the collection keeps the claim true by construction.
 */
const NUMBER_WORDS = [
  'Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six',
  'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve',
];
const count = engagements.length;
const countWord = NUMBER_WORDS[count] ?? String(count);
const sectorCount = new Set<string>(engagements.map((e) => e.sector)).size;
const sectorWord = NUMBER_WORDS[sectorCount]?.toLowerCase() ?? String(sectorCount);

/* Meta description must land in the 110–180 char window the postbuild
   sentinel enforces. Sector names are listed until the budget is spent so
   the snippet stays specific without risking overflow. */
const sectorList: string[] = Array.from(
  new Set<string>(engagements.map((e) => e.sector.toLowerCase())),
);
function engagementsMetaDescription(): string {
  const head = `${countWord} engagements across ${sectorWord} sectors: `;
  const tail = ' Production-grade strategic deliverables in days, not months.';
  const picked: string[] = [];
  for (const s of sectorList) {
    const candidate = [...picked, s].join(', ');
    if ((head + candidate + '.' + tail).length > 178) break;
    picked.push(s);
  }
  const body = picked.length > 0 ? `${picked.join(', ')}.` : sectorList[0] ?? '';
  let out = (head + body + tail).replace(/\s+/g, ' ').trim();
  /* Floor guard: pad with the firm name rather than emit a thin snippet. */
  if (out.length < 110) out = `${out} Sarif Consulting engagement archive.`;
  return out;
}
---

<Base
  title="Engagements — Sarif Consulting"
  description={engagementsMetaDescription()}
>
  <section class="eng-hero section" aria-labelledby="eng-heading">
    <div class="container eng-hero-inner">
      <p class="section-label reveal-on-scroll">What We Have Done</p>
      <h1 id="eng-heading" class="section-header connector-line reveal-on-scroll">Engagements</h1>
      <p class="eng-intro content-back-panel reveal-on-scroll sarif-gold-cap-line">
        {countWord} engagements across {sectorWord} sectors.
      </p>
    </div>

    <div class="container eng-carousel-wrap" data-lobby-subpose="engagements-carousel">
      <EngagementCarousel items={engagements} />
    </div>

    <nav class="container eng-directory reveal-on-scroll" aria-label="Exhibit directory">
      <p class="eng-directory__label ui-eyebrow">Exhibition index</p>
      <ul class="eng-directory__list" role="list">
        {engagements.map((eng) => (
          <li>
            <a
              class="eng-directory__link"
              href={eng.href}
              data-eng-accent={eng.accent}
              data-testid={`exhibit-directory-link-${eng.id}`}
            >
              <span class="eng-directory__num" aria-hidden="true">{eng.num}</span>
              <span class="eng-directory__sector">{eng.sector}</span>
              <span class="eng-directory__open" aria-hidden="true">Open dossier →</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <div class="section-threshold reveal-on-scroll" aria-hidden="true">
    <div class="threshold-line"></div>
  </div>

  <section class="eng-cta section cv-auto" data-cv-size="sm" aria-label="Next steps">
    <div class="container eng-cta-inner">
      <a href="/contact/" class="btn-gold cyan-gold-label lane-cta"><span class="sarif-hover-sheen">Initiate Contact</span></a>
      <a href="/services/" class="eng-services-link">View Services</a>
    </div>
  </section>
</Base>

<style>
  /* Single column: hero copy and carousel stack with normal .section top padding (clears fixed nav) */
  .eng-hero.section {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .eng-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
  }

  .eng-intro {
    max-width: 540px;
    margin-top: 8px;
  }

  .eng-carousel-wrap {
    margin-top: 32px;
    width: 100%;
  }

  .eng-cta {
    padding-block: 56px;
  }

  .eng-cta-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 32px;
    text-align: center;
  }

  @media (max-width: 480px) {
    .eng-cta-inner {
      flex-direction: column;
      gap: 20px;
    }
  }

  .eng-directory {
    margin-top: clamp(28px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .eng-directory__label {
    margin: 0;
    color: var(--sarif-gold);
  }

  .eng-directory__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .eng-directory__link {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 16px;
    text-decoration: none;
    border: 1px solid rgba(200, 196, 190, 0.14);
    background: rgba(4, 12, 18, 0.4);
    clip-path: var(--clip-sm);
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .eng-directory__link:hover,
  .eng-directory__link:focus-visible {
    border-color: rgba(0, 212, 255, 0.45);
    background: rgba(0, 212, 255, 0.06);
    transform: translateY(-2px);
    outline: none;
  }

  .eng-directory__num {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--cyan-core);
  }

  /*
   * NO per-accent override here, deliberately.
   *
   * This used to paint the `venture` and `education` accents gold, which made
   * exhibit 005 the single gold number in an otherwise cyan index — read as a
   * defect rather than as a signal, because nothing about 005 is special in
   * this list.
   *
   * The distinction being drawn was a real one in the WRONG place. On a
   * dossier page the accent is the exhibit's identity: `[slug].astro` gives
   * education and venture a gold `--exh-a1`, and that still stands. But here
   * the number is an INDEX MARKER — its job is to be scannable and uniform so
   * the eye can count down the list. Two colours in an index imply a
   * taxonomy the index does not actually have.
   *
   * So the accent system is intact where it means something and absent where
   * it did not. Deleting the rule rather than remapping `education` to cyan is
   * the point: a per-accent rule whose every branch resolves to the same
   * colour is a trap for the next person to edit it.
   */

  .eng-directory__sector {
    font-family: var(--font-ticker);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .eng-directory__open {
    font-family: var(--font-ticker);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.25s ease;
  }

  .eng-directory__link:hover .eng-directory__open,
  .eng-directory__link:focus-visible .eng-directory__open {
    color: var(--cyan-bright);
  }

  .eng-services-link {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    border-bottom: 1px solid rgba(200, 196, 190, 0.25);
    padding-bottom: 2px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .eng-services-link:hover,
  .eng-services-link:focus-visible {
    color: var(--cyan-core);
    border-color: var(--cyan-core);
  }

  .section-threshold {
    position: relative;
    height: 1px;
    overflow: visible;
    opacity: 1 !important;
    transform: none !important;
  }

  /* Page override: match global threshold-line but with a slower 1.5s
     sweep. Animates `transform: scaleX()` instead of `width` so the
     reveal runs on the compositor. Target width lives in `width`;
     scale drives the visual growth. */
  .threshold-line {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: min(80%, 600px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyan-core), transparent);
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.25);
    transform-origin: center;
    will-change: transform;
  }

  .section-threshold.is-visible .threshold-line {
    transform: translateX(-50%) scaleX(var(--threshold-scale, 1));
    transition: transform 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .section-threshold .threshold-line { transition: none !important; }
    .eng-services-link { transition: none; }
  }
</style>
