---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<div id="jensen-root" transition:persist="jensen" data-sitekey={turnstileSiteKey} data-lenis-prevent>
  <a id="jensen-launcher" href="/contact/" aria-haspopup="dialog" aria-controls="jensen-panel" aria-expanded="false">
    <svg class="jensen-sigil" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="2.1" fill="currentColor"></circle>
      <circle cx="12" cy="4.2" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
      <circle cx="18.2" cy="16.4" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
      <circle cx="5.8" cy="16.4" r="1.5" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
      <path d="M12 9.6 V5.2 M13.6 13.4 L17.4 15.6 M10.4 13.4 L6.6 15.6" fill="none" stroke="currentColor" stroke-width="1.2"></path>
    </svg>
    <span class="jensen-launcher-label">Ask Jensen</span>
    <span class="jensen-launcher-dot" hidden></span>
  </a>
</div>
<script>
  import { bootJensen } from '../scripts/jensen/loader.js';
  bootJensen();
</script>
<style>
  #jensen-launcher {
    position: fixed;
    right: max(1.25rem, env(safe-area-inset-right, 0px));
    bottom: max(1.25rem, env(safe-area-inset-bottom, 0px));
    z-index: 1100;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.85rem 0.45rem 0.5rem;
    color: var(--lobby-white, #faf8f5);
    background: rgba(9, 12, 18, 0.92);
    text-decoration: none;
    clip-path: var(--clip-button);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-family: var(--font-heading, Orbitron, system-ui, sans-serif);
    font-size: 0.68rem;
  }
  #jensen-launcher .jensen-sigil {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--cyan-core, #00d4ff);
  }
  /* The chamfer clips outer shadows and filters, so emphasis is drawn inside the shape. */
  #jensen-launcher::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0;
    height: 1px;
    background: var(--cyan-core, #00d4ff);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
  }
  #jensen-launcher:hover {
    box-shadow: inset 0 0 0 1px rgba(0, 212, 255, 0.45);
  }
  #jensen-launcher:hover::after {
    transform: scaleX(1);
    opacity: 1;
  }
  #jensen-launcher:focus-visible {
    outline: 2px solid var(--cyan-core, #00d4ff);
    outline-offset: 3px;
  }
  #jensen-launcher .jensen-launcher-dot {
    width: 0.4rem;
    height: 0.4rem;
    background: var(--sarif-gold, #c9a227);
    border-radius: 50%;
  }
  #jensen-launcher .jensen-launcher-dot[hidden] { display: none; }
  #jensen-launcher[data-motion="full"]::after {
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 240ms ease;
  }
  #jensen-launcher[data-motion="full"].is-ready .jensen-sigil {
    animation: jensen-breathe 3.6s ease-in-out infinite;
  }
  #jensen-launcher[data-motion="full"].is-answering::after {
    opacity: 1;
    animation: jensen-sweep 1.4s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  #jensen-launcher.is-answering::after {
    transform: scaleX(1);
    opacity: 1;
  }
  @keyframes jensen-breathe {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }
  @keyframes jensen-sweep {
    0% { transform: scaleX(0); transform-origin: left center; }
    50% { transform: scaleX(1); transform-origin: left center; }
    50.01% { transform: scaleX(1); transform-origin: right center; }
    100% { transform: scaleX(0); transform-origin: right center; }
  }
  @media (prefers-reduced-motion: reduce) {
    #jensen-launcher { transition: none; animation: none; }
  }
</style>
