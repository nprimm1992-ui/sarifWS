---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { splitStatValue } from '../lib/stat-value';

export type EngagementAccent = 'policy' | 'civic' | 'venture' | 'founder' | 'education' | 'digital' | 'legal';

/** Carousel cards use `preview`; the dossier page is the full exhibit. */
export type ProofEntryVariant = 'preview' | 'full';

interface Props {
  classification: string;
  content?: string;
  id?: string;
  num?: string;
  class?: string;
  sector?: string;
  statValue?: string;
  statLabel?: string;
  leads?: string[];
  highlights?: string[];
  heroImage?: ImageMetadata;
  heroAlt?: string;
  accent?: EngagementAccent;
  variant?: ProofEntryVariant;
  /** When set, renders an "Open full dossier" link to the exhibit page. */
  href?: string;
}

const {
  classification,
  content,
  id,
  num,
  class: className,
  sector,
  statValue,
  statLabel,
  leads = [],
  highlights = [],
  heroImage,
  heroAlt,
  accent,
  variant = 'full',
  href,
} = Astro.props;

const isDossier = highlights.length > 0 && leads.length > 0;
const isPreview = variant === 'preview' && isDossier;
const plateAlt = heroAlt?.trim();
const hasPreviewPlate = isPreview && Boolean(heroImage && plateAlt && href);
const logCountLabel =
  highlights.length > 0 ? String(highlights.length).padStart(2, '0') : '00';
---

<article
  class:list={[
    'proof-entry',
    'panel-frost-base',
    'panel-dossier',
    'panel-dossier--interactive',
    isPreview && 'proof-entry--preview',
    className,
  ]}
  data-reveal-item
  data-eng-accent={accent}
  data-proof-variant={variant}
  id={id}
>
  <div class="proof-entry__accent" aria-hidden="true"></div>
  {num && <span class="proof-entry__num" aria-hidden="true">{num}</span>}

  {
    isDossier ? (
      <div class="proof-entry__body">
        {isPreview ? (
          <div class="proof-entry__preview-head">
            <div class="proof-entry__preview-meta">
              {sector && <p class="proof-entry__sector sarif-gold-cap-line">{sector}</p>}
              <h2 class="proof-entry__classification ui-eyebrow">{classification}</h2>
              {statValue && (
                <div class="proof-entry__stat" aria-hidden="true">
                  <span class="proof-entry__stat-value">
                    {splitStatValue(statValue).map((seg) =>
                      seg.kind === 'unit' ? (
                        <span class="proof-entry__stat-unit">{seg.text}</span>
                      ) : (
                        seg.text
                      ),
                    )}
                  </span>
                  {statLabel && <span class="proof-entry__stat-label">{statLabel}</span>}
                </div>
              )}
            </div>
            {hasPreviewPlate && (
              <a
                class="proof-entry__plate-link"
                href={href}
                data-testid={`preview-plate-${id ?? num}`}
                aria-label={`View dossier plate ${num}: ${plateAlt}`}
              >
                <figure class="proof-entry__plate">
                  <Picture
                    src={heroImage!}
                    alt={plateAlt!}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 720px) 280px, 42vw"
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    loading="lazy"
                    decoding="async"
                  pictureAttributes={{ class: 'proof-entry__plate-picture' }}
                />
              </figure>
              </a>
            )}
          </div>
        ) : (
          <>
            {sector && <p class="proof-entry__sector sarif-gold-cap-line">{sector}</p>}
            <h2 class="proof-entry__classification ui-eyebrow">{classification}</h2>
            {statValue && (
              <div class="proof-entry__stat" aria-hidden="true">
                <span class="proof-entry__stat-value">
                  {splitStatValue(statValue).map((seg) =>
                    seg.kind === 'unit' ? (
                      <span class="proof-entry__stat-unit">{seg.text}</span>
                    ) : (
                      seg.text
                    ),
                  )}
                </span>
                {statLabel && <span class="proof-entry__stat-label">{statLabel}</span>}
              </div>
            )}
          </>
        )}
        <div class="proof-entry__mandate">
          {leads.map((lead) => (
            <p class="proof-entry__lead">{lead}</p>
          ))}
        </div>
        {!isPreview && (
          <ul class="proof-entry__highlights" role="list">
            {highlights.map((line) => (
              <li class="sarif-gold-cap-line" set:html={line} />
            ))}
          </ul>
        )}
        {href && (
          <a
            class="proof-entry__open"
            href={href}
            data-testid={`open-dossier-${id ?? num}`}
          >
            <span>
              {isPreview
                ? `Open full dossier — ${logCountLabel} log entries`
                : 'Open full dossier'}
            </span>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12 12 4M6 4h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
            </svg>
          </a>
        )}
      </div>
    ) : (
      <>
        <h2 class="proof-entry__classification ui-eyebrow">{classification}</h2>
        {content && <p class="proof-entry__content">{content}</p>}
      </>
    )
  }
</article>

<style>
  .proof-entry {
    padding: 36px 36px 36px 40px;
    position: relative;
    overflow: hidden;
    clip-path: var(--clip-card);
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
    opacity: 0;
    transform: translateY(20px);
  }

  .proof-entry.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .proof-entry__accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(to bottom, var(--cyan-core), rgba(0, 212, 255, 0.2));
  }

  .proof-entry[data-eng-accent='policy'] .proof-entry__accent {
    background: linear-gradient(
      to bottom,
      var(--cyan-core) 0%,
      rgba(0, 212, 255, 0.45) 40%,
      rgba(221, 184, 61, 0.55) 100%
    );
  }

  .proof-entry[data-eng-accent='civic'] .proof-entry__accent {
    background: linear-gradient(to bottom, var(--cyan-bright), rgba(0, 153, 187, 0.25));
  }

  .proof-entry[data-eng-accent='venture'] .proof-entry__accent {
    background: linear-gradient(
      to bottom,
      var(--sarif-gold) 0%,
      rgba(221, 184, 61, 0.5) 45%,
      rgba(0, 212, 255, 0.35) 100%
    );
  }

  .proof-entry[data-eng-accent='founder'] .proof-entry__accent {
    background: linear-gradient(to bottom, var(--cyan-core), rgba(0, 212, 255, 0.35));
  }

  .proof-entry[data-eng-accent='education'] .proof-entry__accent {
    background: linear-gradient(
      to bottom,
      rgba(221, 184, 61, 0.85) 0%,
      var(--cyan-core) 55%,
      rgba(0, 212, 255, 0.2) 100%
    );
  }

  .proof-entry[data-eng-accent='digital'] .proof-entry__accent {
    background: linear-gradient(to bottom, var(--cyan-bright), var(--cyan-core));
  }

  /*
   * `legal` — regulated work. Gold reads as the constraint (statute, opinion,
   * bar rule) resolving into cyan: the system that gets built inside it. The
   * inverse of `venture`, which opens on gold ambition and cools toward
   * execution. Distinct from `digital` so no two exhibits share a stripe.
   */
  .proof-entry[data-eng-accent='legal'] .proof-entry__accent {
    background: linear-gradient(
      to bottom,
      rgba(221, 184, 61, 0.75) 0%,
      rgba(0, 153, 187, 0.6) 50%,
      var(--cyan-core) 100%
    );
  }

  .proof-entry__open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin-top: 18px;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan-core);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(0, 212, 255, 0.35);
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .proof-entry__open:hover,
  .proof-entry__open:focus-visible {
    color: var(--cyan-bright);
    border-color: var(--cyan-bright);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-entry__open {
      transition: none;
    }
  }

  .proof-entry__num {
    position: absolute;
    top: 12px;
    right: 16px;
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--sarif-gold);
    opacity: 0.12;
    pointer-events: none;
    user-select: none;
  }

  /* Hover lift only — border/shadow is carried by the shared
     `.panel-dossier--interactive:hover` in global.css so the carousel
     and standalone proof entries both read with the same cyan-only
     hover signature the rest of the dossier family uses. */
  .proof-entry:hover {
    transform: translateY(-6px);
  }

  /* Carousel variant keeps its denser frost alpha (harmless on the
     opaque dossier fill, but preserved for the non-dossier legacy
     path if it's ever used without panel-dossier). The warm gold
     border-top seam was dropped — it fought the cyan border of the
     dossier palette. */
  .proof-entry--carousel {
    --panel-frost-fill-alpha: 0.1;
  }

  /* ── Preview variant: mandate on card, operations log in dossier only ─ */
  .proof-entry--preview {
    padding: clamp(24px, 3vw, 32px) clamp(24px, 3vw, 36px) clamp(28px, 3.5vw, 36px)
      clamp(28px, 3.5vw, 40px);
  }

  .proof-entry--preview .proof-entry__body {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.5vw, 24px);
    min-width: 0;
  }

  .proof-entry__preview-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(16px, 2.5vw, 20px);
    align-items: start;
  }

  @media (min-width: 640px) {
    .proof-entry__preview-head {
      grid-template-columns: minmax(0, 1fr) minmax(200px, 38%);
      gap: clamp(18px, 3vw, 28px);
    }
  }

  .proof-entry__preview-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .proof-entry__preview-meta .proof-entry__stat {
    margin-bottom: 0;
  }

  .proof-entry__mandate {
    min-width: 0;
  }

  .proof-entry__plate-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .proof-entry__plate-link:hover,
  .proof-entry__plate-link:focus-visible {
    outline: none;
  }

  .proof-entry__plate-link:focus-visible .proof-entry__plate {
    box-shadow: 0 0 0 2px var(--cyan-core);
  }

  .proof-entry__plate {
    position: relative;
    margin: 0;
    padding: clamp(6px, 1vw, 10px);
    border: 1px solid rgba(0, 212, 255, 0.16);
    background:
      linear-gradient(135deg, rgba(0, 212, 255, 0.05), transparent 58%),
      rgba(4, 12, 18, 0.5);
    clip-path: var(--clip-sm);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .proof-entry__plate-link:hover .proof-entry__plate,
  .proof-entry__plate-link:focus-visible .proof-entry__plate {
    border-color: rgba(0, 212, 255, 0.38);
    box-shadow: 0 6px 22px rgba(0, 212, 255, 0.1);
  }

  .proof-entry__plate-picture,
  .proof-entry__plate-picture :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(28vh, 220px);
    object-fit: contain;
    object-position: center;
    background: rgba(2, 8, 14, 0.55);
  }

  .proof-entry__sector {
    margin: 0 0 10px;
    max-width: 100%;
  }

  h2.proof-entry__classification {
    margin: 0 0 14px;
  }

  .proof-entry__stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin: 0 0 22px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(0, 212, 255, 0.12);
  }

  .proof-entry__stat-value {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5.5vw, 3rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.05;
    color: var(--gold-bright);
    text-shadow: var(--gold-glow-soft);
    filter: brightness(1.08);
  }

  /*
   * Magnitude suffix, tinted cyan against the gold digits.
   *
   * Not a decorative choice. Orbitron's `B` is metrically IDENTICAL to its
   * `8` — measured: same 33px cap height, same 33px ink width, same 37px
   * advance, same baseline — so `$868B` scans as a four-digit run ending in a
   * malformed 8. There is no kerning error to fix; the glyph needs its own
   * channel or it keeps reading as a digit. Colour separates them without
   * touching the metrics, so the number stays on one optical baseline.
   *
   * `em` sizing keeps the suffix proportional to whatever the clamp() above
   * resolves to, so this holds at every viewport rather than only at desktop.
   */
  .proof-entry__stat-unit {
    color: var(--cyan-core);
    font-size: 0.86em;
    letter-spacing: 0.02em;
    /* Cancels the parent's gold glow so the two inks stay distinct. */
    text-shadow: 0 0 18px rgba(0, 212, 255, 0.4);
  }

  .proof-entry__stat-label {
    font-family: var(--font-heading);
    font-size: clamp(0.58rem, 1.2vw, 0.68rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.35;
    max-width: 22rem;
  }

  .proof-entry__lead {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-primary);
    line-height: 1.82;
    margin: 0 0 16px;
  }

  .proof-entry__lead:last-of-type {
    margin-bottom: 18px;
  }

  .proof-entry--preview .proof-entry__lead:last-of-type {
    margin-bottom: 0;
  }

  .proof-entry__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Gold ink + diamond marker — mirrors services lane-list-item + .sarif-gold-cap-line */
  .proof-entry__highlights li {
    position: relative;
    padding-left: 16px;
    margin-bottom: 8px;
    text-align: left;
  }

  .proof-entry__highlights li:last-child {
    margin-bottom: 0;
  }

  .proof-entry__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    background: var(--gold-bright);
    box-shadow: 0 0 6px rgba(221, 184, 61, 0.45);
    transform: rotate(45deg);
  }

  .proof-entry__content {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-primary);
    line-height: 1.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-entry {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .proof-entry__stat-value {
      filter: none;
    }

    .proof-entry__highlights li::before {
      box-shadow: none;
    }

    .proof-entry__plate-link,
    .proof-entry__plate {
      transition: none;
    }
  }
</style>
