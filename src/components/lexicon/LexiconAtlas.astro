---
/**
 * LexiconAtlas — the lexicon as a navigable 3D substrate.
 *
 * This replaces the flat "constellation" panel. The vocabulary is no
 * longer a decorative graph above a list of dropdowns; the graph IS
 * the interface and every definition is absorbed into an inspector
 * docked inside the scene.
 *
 * Depth model (the "immersed in the diorama" illusion):
 *   • Every term gets a world coordinate (wx, wy, wz). Layout in the
 *     XY plane comes from a deterministic seeded force simulation run
 *     at BUILD time; Z comes from the term's category channel plus its
 *     connection degree (hubs sit nearer the camera).
 *   • The panel has no frost fill — the WebGL lobby diorama behind the
 *     page IS the sky — the stage is frameless and fill-free. Per-depth
 *     scale, depth fog, a depth-of-field blur bucket, dark underlays on
 *     every edge and a scrim that tracks the field make the graph read
 *     as an object suspended in that space rather than a chart pasted
 *     on top of it.
 *   • The runtime island (lexicon-atlas.js) owns a small perspective
 *     camera: pointer parallax, ambient drift, drag-pan, wheel/pinch
 *     zoom, fly-to-node on selection, radial ego-graph focus mode.
 *
 * No-JS baseline: positions below are projected at build time with the
 * home camera, so the scene renders correctly as a static SVG and
 * every node stays a plain `<a href="#term-id">` that lands on the
 * term's inspector card within the same surface.
 */
import { getLexiconGraph, LEXICON_CATEGORY_META, formatIsoDay } from '../../lib/lexicon-graph';
import { getLexiconUsage } from '../../lib/lexicon-usage';
import LexiconChip from './LexiconChip.astro';

const graph = await getLexiconGraph();
/* Provenance: which articles and engagements actually use each term. */
const usage = await getLexiconUsage();

/* ── Camera constants — MIRRORED in src/scripts/lexicon-atlas.js ── */
const VB_W = 1000;
const VB_H = 625;
const CX = VB_W / 2;
const CY = 312;
const FOCAL = 1500;
const CAM_DIST = 1500;
const HOME_YAW = -0.18;
const HOME_PITCH = -0.13;

/* Unique undirected edges from declared related[] pointers. */
const edgeKeys = new Set<string>();
const edges: { a: string; b: string }[] = [];
for (const e of graph.flat) {
  for (const rel of e.related) {
    if (!graph.byId.has(rel.id)) continue;
    const key = [e.id, rel.id].sort().join('~');
    if (edgeKeys.has(key)) continue;
    edgeKeys.add(key);
    edges.push({ a: e.id, b: rel.id });
  }
}

/* ── Octagonal matrix layout ─────────────────────────────────────
 *
 * The vocabulary is not an organic blob: it is a constructed figure.
 * Terms are seated on a three-ring octagonal armature — an axis term at
 * the centre, eight on the primary octagon, the remainder on an outer
 * octagon rotated off-axis. Placement is fully deterministic (no force
 * simulation, no PRNG): order around the ring is category, then degree,
 * so each channel occupies a contiguous arc of the figure.
 *
 * Depth follows the geometry rather than the taxonomy: the axis sits
 * nearest the viewer, the primary ring alternates ±Z like an antiprism
 * (so orbiting reveals it as a solid, not a decal), and the outer ring
 * recedes.
 */
const R_CORE = 118;
const R_RING = 226;
const R_OUTER = 358;
const VERTICES = 8;
const STEP = (Math.PI * 2) / VERTICES;
const TOP = -Math.PI / 2;
const HALF_STEP = STEP / 2;
/* The figure is flattened on Y: a plate seen slightly from above rather
   than a wheel facing the viewer. It also lets the whole construction
   sit inside a 16:10 frame without cropping. */
const FLAT = 0.7;

/** Octagon vertex in the z-plane of the figure. */
function vertex(radius: number, index: number, rotate = 0) {
  const a = TOP + index * STEP + rotate;
  return { x: Math.cos(a) * radius, y: Math.sin(a) * radius * FLAT, a };
}

const CAT_ORDER: Record<string, number> = {
  doctrine: 0,
  substrate: 1,
  discipline: 2,
  engagement: 3,
  uncategorized: 4,
};

const degrees = new Map(graph.flat.map((n) => [n.id, n.related.length + n.incoming.length]));

/* The axis is the most connected term — the figure is built around it. */
const ordered = [...graph.flat].sort(
  (a, b) => (degrees.get(b.id) ?? 0) - (degrees.get(a.id) ?? 0),
);
/* The axis is the firm's thesis term — the figure is built around it. */
const AXIS_ID = 'augment-your-intelligence';
const axisId = graph.byId.has(AXIS_ID) ? AXIS_ID : (ordered[0]?.id ?? '');

const seated = graph.flat
  .filter((n) => n.id !== axisId)
  .sort(
    (a, b) =>
      (CAT_ORDER[a.category] ?? 9) - (CAT_ORDER[b.category] ?? 9) ||
      (degrees.get(b.id) ?? 0) - (degrees.get(a.id) ?? 0) ||
      a.term.localeCompare(b.term),
  );

const extras = Math.max(seated.length - VERTICES, 0);
type Seat = { x: number; y: number; z: number; ring: 'axis' | 'ring' | 'outer'; a: number };
const seats = new Map<string, Seat>();
seats.set(axisId, { x: 0, y: 0, z: 84, ring: 'axis', a: 0 });
seated.forEach((n, i) => {
  if (i < VERTICES) {
    const v = vertex(R_RING, i);
    /* Antiprism shimmer: alternate vertices lean toward and away from
       the viewer so the ring reads as a solid figure under orbit. */
    seats.set(n.id, { x: v.x, y: v.y, z: i % 2 === 0 ? 34 : -34, ring: 'ring', a: v.a });
  } else {
    const slot = i - VERTICES;
    const spread = extras > 0 ? (VERTICES / extras) * slot : 0;
    const v = vertex(R_OUTER, spread, HALF_STEP);
    seats.set(n.id, { x: v.x, y: v.y, z: -104, ring: 'outer', a: v.a });
  }
});

/* ── Build-time projection with the home camera (no-JS baseline) ── */
function project(wx: number, wy: number, wz: number) {
  const cy = Math.cos(HOME_YAW);
  const sy = Math.sin(HOME_YAW);
  const x1 = cy * wx + sy * wz;
  const z1 = -sy * wx + cy * wz;
  const cp = Math.cos(HOME_PITCH);
  const sp = Math.sin(HOME_PITCH);
  const y1 = cp * wy - sp * z1;
  const z2 = sp * wy + cp * z1;
  const s = FOCAL / (CAM_DIST + z2);
  return { x: CX + x1 * s, y: CY + y1 * s, s };
}
const r1 = (v: number) => Math.round(v * 10) / 10;
const r3 = (v: number) => Math.round(v * 1000) / 1000;

type AtlasNode = {
  id: string;
  term: string;
  termFull: string;
  num: string;
  category: string;
  categoryLabel: string;
  def: string;
  degree: number;
  wx: number;
  wy: number;
  wz: number;
  ring: string;
  sx: number;
  sy: number;
  s: number;
  r: number;
};

function truncateDef(s: string, max = 150): string {
  if (s.length <= max) return s;
  const cut = s.slice(0, max - 1);
  return `${cut.slice(0, cut.lastIndexOf(' '))}…`;
}

const nodes: AtlasNode[] = graph.flat.map((n) => {
  const seat = seats.get(n.id)!;
  const degree = degrees.get(n.id) ?? 0;
  const wx = r1(seat.x);
  const wy = r1(seat.y);
  const wz = r1(seat.z);
  const proj = project(wx, wy, wz);
  return {
    id: n.id,
    term: n.term,
    termFull: n.termDisplay ?? n.term,
    num: n.num,
    category: n.category,
    categoryLabel: LEXICON_CATEGORY_META[n.category].label,
    def: truncateDef(n.definition),
    degree,
    wx,
    wy,
    wz,
    ring: seat.ring,
    sx: r1(proj.x),
    sy: r1(proj.y),
    s: r3(proj.s),
    r: (seat.ring === 'axis' ? 8 : 5.4) + Math.min(degree, 6) * 0.55,
  };
});

/* Channel captions sit on the figure's outer margin, at the mean
   bearing of that channel's arc — so the caption points at its own
   segment of the octagon instead of floating over a term label. */
const clusters = graph.groups
  .filter((g) => g.entries.length > 0)
  .map((g) => {
    const members = graph.flat.filter((n) => n.category === g.meta.id);
    const bearings = members
      .map((n) => seats.get(n.id))
      .filter((seat): seat is Seat => Boolean(seat) && seat!.ring !== 'axis');
    const sum = bearings.reduce(
      (acc, seat) => ({ x: acc.x + Math.cos(seat.a), y: acc.y + Math.sin(seat.a) }),
      { x: 0, y: 0 },
    );
    const a = bearings.length > 0 ? Math.atan2(sum.y, sum.x) : TOP;
    const radius = R_OUTER + 96;
    const wx = r1(Math.cos(a) * radius);
    const wy = r1(Math.sin(a) * radius * FLAT);
    const p = project(wx, wy, 0);
    return { id: g.meta.id, label: g.meta.label, wx, wy, wz: 0, sx: r1(p.x), sy: r1(p.y), s: r3(p.s) };
  });

/* ── Sacred-geometry armature ────────────────────────────────────
 * Faint scaffolding that makes the construction visible: three
 * concentric octagons, a half-step-rotated octagon forming the
 * eight-pointed star, eight radial spokes, and the {8/3} octagram
 * chording the primary ring. All of it lives in the figure's own
 * z-plane and is re-projected by the camera, so it turns with the
 * matrix instead of sitting on the glass.
 */
type GlyphPoly = { pts: [number, number, number][]; kind: string };
type GlyphLine = { ax: number; ay: number; az: number; bx: number; by: number; bz: number; kind: string };

function ring(radius: number, rotate = 0): [number, number, number][] {
  return Array.from({ length: VERTICES + 1 }, (_, i) => {
    const v = vertex(radius, i % VERTICES, rotate);
    return [r1(v.x), r1(v.y), 0] as [number, number, number];
  });
}

const glyphPolys: GlyphPoly[] = [
  { pts: ring(R_CORE), kind: 'core' },
  { pts: ring(R_RING), kind: 'ring' },
  { pts: ring(R_RING, HALF_STEP), kind: 'star' },
  { pts: ring(R_OUTER), kind: 'outer' },
];

const glyphLines: GlyphLine[] = [];
for (let i = 0; i < VERTICES; i++) {
  const inner = vertex(R_CORE, i);
  const outer = vertex(R_OUTER, i);
  glyphLines.push({
    ax: r1(inner.x), ay: r1(inner.y), az: 0,
    bx: r1(outer.x), by: r1(outer.y), bz: 0,
    kind: 'spoke',
  });
  /* {8/3} octagram — the chord that gives the figure its star. */
  const from = vertex(R_RING, i);
  const to = vertex(R_RING, (i + 3) % VERTICES);
  glyphLines.push({
    ax: r1(from.x), ay: r1(from.y), az: 0,
    bx: r1(to.x), by: r1(to.y), bz: 0,
    kind: 'octagram',
  });
}

/* Build-time projections for the no-JS baseline. */
const glyphPolyGeometry = glyphPolys.map((g) => ({
  ...g,
  data: g.pts.map((pt) => pt.join(',')).join(';'),
  points: g.pts
    .map((pt) => {
      const pr = project(pt[0], pt[1], pt[2]);
      return `${r1(pr.x)},${r1(pr.y)}`;
    })
    .join(' '),
}));

const glyphLineGeometry = glyphLines.map((g) => {
  const pa = project(g.ax, g.ay, g.az);
  const pb = project(g.bx, g.by, g.bz);
  return { ...g, x1: r1(pa.x), y1: r1(pa.y), x2: r1(pb.x), y2: r1(pb.y) };
});

const channels = graph.groups
  .filter((g) => g.entries.length > 0)
  .map((g) => ({ id: g.meta.id, label: g.meta.label, count: g.entries.length }));

const edgeGeometry = edges.map((e) => {
  const a = nodes.find((n) => n.id === e.a)!;
  const b = nodes.find((n) => n.id === e.b)!;
  return { ...e, x1: a.sx, y1: a.sy, x2: b.sx, y2: b.sy };
});

/* Inspector cards — the former <details> panel content, rebuilt as
   the scene's own readout surface. */
const cards = graph.flat.map((n) => ({
  id: n.id,
  num: n.num,
  term: n.termDisplay ?? n.term,
  category: LEXICON_CATEGORY_META[n.category].label,
  categoryId: n.category,
  status: n.status,
  revised: formatIsoDay(n.lastReviewed),
  definition: n.definition,
  aka: n.aka,
  related: n.related,
  incoming: n.incoming,
  citation: n.citation,
  permalink: n.permalink,
  degree: degrees.get(n.id) ?? 0,
  usage: usage.get(n.id) ?? { praxis: [], engagements: [], total: 0 },
}));
---

<section
  class="atlas reveal-on-scroll"
  aria-labelledby="atlas-heading"
  data-lex-atlas
  data-atlas
  data-lex-map
  data-lobby-subpose="lexicon-atlas"
  data-atlas-extent-x={R_OUTER + 70}
  data-atlas-extent-y={Math.round(R_OUTER * FLAT) + 70}
  data-testid="lexicon-atlas"
>
  <div class="atlas__controls" role="region" aria-label="Filter and navigate the lexicon">
    <header class="atlas__bar">
      <div class="atlas__bar-copy">
        <p class="ui-eyebrow atlas__eyebrow">Relational substrate</p>
        <h2 id="atlas-heading" class="atlas__heading">Lexicon Atlas</h2>
        <p class="atlas__hint">
          {graph.count} terms on an octagonal armature, {edges.length} declared relationships.
          Drag to orbit, scroll to close in, select a term to open its entry.
        </p>
      </div>

      <dl class="atlas__readout" data-testid="atlas-readout">
        <div class="atlas__readout-cell">
          <dt>Version</dt><dd>{graph.version}</dd>
        </div>
        <div class="atlas__readout-cell">
          <dt>Edges</dt><dd>{edges.length}</dd>
        </div>
        <div class="atlas__readout-cell">
          <dt>Categories</dt><dd>{graph.categoryCount}</dd>
        </div>
        <div class="atlas__readout-cell">
          <dt>Revised</dt><dd>{formatIsoDay(graph.updatedAt)}</dd>
        </div>
        <div class="atlas__readout-cell">
          <dt>Selected</dt><dd data-atlas-readout-sel data-testid="atlas-readout-selected">—</dd>
        </div>
        <div class="atlas__readout-cell">
          <dt>Lens</dt><dd data-atlas-readout-zoom>1.00×</dd>
        </div>
      </dl>
    </header>

    <div class="atlas__interaction">
      <div class="atlas__search">
      <label class="atlas__search-label" for="lex-filter">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M10.5 10.5 L13.5 13.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <span class="visually-hidden">Filter terms</span>
      </label>
      <input
        id="lex-filter"
        class="atlas__search-input"
        type="search"
        placeholder="Filter — press / to focus"
        autocomplete="off"
        spellcheck="false"
        aria-describedby="lex-filter-count"
        data-lex-filter
        data-testid="atlas-filter-input"
      />
      <span id="lex-filter-count" class="atlas__count" aria-live="polite" aria-atomic="true">
        {graph.count} of {graph.count}
      </span>
    </div>

    <div class="atlas__channels" role="group" aria-label="Filter by channel">
      <LexiconChip pressed={false} class="atlas__chip" category="all">All</LexiconChip>
      {channels.map((c) => (
        <LexiconChip pressed={false} class="atlas__chip" category={c.id}>
          <span class="atlas__chip-dot" data-cat={c.id} aria-hidden="true"></span>
          {c.label}
          <span class="atlas__chip-count">{String(c.count).padStart(2, '0')}</span>
        </LexiconChip>
      ))}
    </div>

    <div class="atlas__view" role="group" aria-label="Atlas view controls">
      <button type="button" class="atlas__view-btn" data-atlas-zoom="-1" aria-label="Zoom out" data-testid="atlas-zoom-out">−</button>
      <button type="button" class="atlas__view-btn" data-atlas-zoom="1" aria-label="Zoom in" data-testid="atlas-zoom-in">+</button>
      <button type="button" class="atlas__view-btn atlas__view-btn--wide" data-atlas-reset data-testid="atlas-reset">Fit</button>
      <button
        type="button"
        class="atlas__view-btn atlas__view-btn--wide"
        data-atlas-focus
        aria-pressed="false"
        data-testid="atlas-focus-toggle"
      >Focus</button>
    </div>
    </div>
  </div>

  <div class="atlas__stage" data-atlas-stage data-testid="atlas-stage">
    <svg
      class="atlas__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="group"
      aria-label={`Lexicon atlas: ${graph.count} terms suspended in a relationship field with ${edges.length} connections. Each node opens its entry.`}
      data-atlas-svg
    >
      <defs>
        {/* Depth-of-field: distant nodes blur into atmospheric haze */}
        <filter id="atlas-dof" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="1.8" />
        </filter>
        {/* Bloom — luminous halo around bright nodes and hot edges */}
        <filter id="atlas-bloom" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="3.5" result="blur1" />
          <feGaussianBlur stdDeviation="1.2" in="SourceGraphic" result="blur2" />
          <feMerge>
            <feMergeNode in="blur1" />
            <feMergeNode in="blur2" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        {/* Soft glow for selected node — wider, warmer bloom */}
        <filter id="atlas-bloom-hot" x="-120%" y="-120%" width="340%" height="340%">
          <feGaussianBlur stdDeviation="6" result="b1" />
          <feGaussianBlur stdDeviation="2" in="SourceGraphic" result="b2" />
          <feMerge>
            <feMergeNode in="b1" />
            <feMergeNode in="b2" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        {/* Edge glow — energy-flow lines get a luminous sheath */}
        <filter id="atlas-edge-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="1.5" result="glow" />
          <feMerge>
            <feMergeNode in="glow" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        {/* Per-category radial gradients for node cores — lit from within */}
        <radialGradient id="atlas-core-doctrine">
          <stop offset="0%" stop-color="rgba(180,250,255,0.95)" />
          <stop offset="40%" stop-color="rgba(0,212,255,0.7)" />
          <stop offset="100%" stop-color="rgba(0,140,200,0.3)" />
        </radialGradient>
        <radialGradient id="atlas-core-substrate">
          <stop offset="0%" stop-color="rgba(255,240,180,0.95)" />
          <stop offset="40%" stop-color="rgba(221,184,61,0.7)" />
          <stop offset="100%" stop-color="rgba(160,120,30,0.3)" />
        </radialGradient>
        <radialGradient id="atlas-core-discipline">
          <stop offset="0%" stop-color="rgba(200,255,230,0.95)" />
          <stop offset="40%" stop-color="rgba(124,232,196,0.7)" />
          <stop offset="100%" stop-color="rgba(60,160,120,0.3)" />
        </radialGradient>
        <radialGradient id="atlas-core-engagement">
          <stop offset="0%" stop-color="rgba(255,255,255,0.95)" />
          <stop offset="40%" stop-color="rgba(230,236,242,0.65)" />
          <stop offset="100%" stop-color="rgba(140,160,180,0.3)" />
        </radialGradient>
        <radialGradient id="atlas-core-uncategorized">
          <stop offset="0%" stop-color="rgba(200,210,220,0.9)" />
          <stop offset="40%" stop-color="rgba(154,167,180,0.6)" />
          <stop offset="100%" stop-color="rgba(100,115,130,0.3)" />
        </radialGradient>
        {/* Axis node — special gold-cyan dual core */}
        <radialGradient id="atlas-core-axis">
          <stop offset="0%" stop-color="rgba(255,245,200,1)" />
          <stop offset="30%" stop-color="rgba(221,184,61,0.85)" />
          <stop offset="70%" stop-color="rgba(0,212,255,0.4)" />
          <stop offset="100%" stop-color="rgba(0,100,160,0.2)" />
        </radialGradient>
        {/* Atmospheric scrim: a soft dark bloom that tracks the field
             itself, not the frame. It reads as the graph's own shadow in
             the diorama's air — enough local contrast for cyan on the
             bright terraced ground, with no panel edge anywhere. */}
        <radialGradient id="atlas-scrim">
          <stop offset="0%" stop-color="rgba(2,9,15,0.34)" />
          <stop offset="55%" stop-color="rgba(2,9,15,0.2)" />
          <stop offset="100%" stop-color="rgba(2,9,15,0)" />
        </radialGradient>
        {/* Deep-space nebula — the graph's own atmospheric background */}
        <radialGradient id="atlas-nebula" cx="50%" cy="42%" r="55%">
          <stop offset="0%" stop-color="rgba(0,40,80,0.18)" />
          <stop offset="30%" stop-color="rgba(0,20,50,0.12)" />
          <stop offset="70%" stop-color="rgba(2,8,14,0.06)" />
          <stop offset="100%" stop-color="rgba(2,8,14,0)" />
        </radialGradient>
        {/* Inner glow ring gradient for halos */}
        <radialGradient id="atlas-halo-doctrine">
          <stop offset="0%" stop-color="rgba(0,212,255,0.25)" />
          <stop offset="60%" stop-color="rgba(0,212,255,0.08)" />
          <stop offset="100%" stop-color="rgba(0,212,255,0)" />
        </radialGradient>
        <radialGradient id="atlas-halo-substrate">
          <stop offset="0%" stop-color="rgba(221,184,61,0.25)" />
          <stop offset="60%" stop-color="rgba(221,184,61,0.08)" />
          <stop offset="100%" stop-color="rgba(221,184,61,0)" />
        </radialGradient>
        <radialGradient id="atlas-halo-discipline">
          <stop offset="0%" stop-color="rgba(124,232,196,0.25)" />
          <stop offset="60%" stop-color="rgba(124,232,196,0.08)" />
          <stop offset="100%" stop-color="rgba(124,232,196,0)" />
        </radialGradient>
        <radialGradient id="atlas-halo-engagement">
          <stop offset="0%" stop-color="rgba(230,236,242,0.22)" />
          <stop offset="60%" stop-color="rgba(230,236,242,0.07)" />
          <stop offset="100%" stop-color="rgba(230,236,242,0)" />
        </radialGradient>
        <radialGradient id="atlas-halo-axis">
          <stop offset="0%" stop-color="rgba(240,205,92,0.35)" />
          <stop offset="50%" stop-color="rgba(0,212,255,0.12)" />
          <stop offset="100%" stop-color="rgba(0,212,255,0)" />
        </radialGradient>
      </defs>

      {/* Deep-space atmospheric layers */}
      <ellipse
        class="atlas__nebula"
        aria-hidden="true"
        cx={CX} cy={CY * 0.92} rx={VB_W * 0.52} ry={VB_H * 0.52}
        fill="url(#atlas-nebula)"
      />
      <ellipse
        class="atlas__scrim"
        data-atlas-scrim
        cx={CX} cy={CY} rx={VB_W * 0.46} ry={VB_H * 0.46}
        fill="url(#atlas-scrim)"
        aria-hidden="true"
      />

      <g class="atlas__glyph" data-atlas-glyph aria-hidden="true">
        {glyphPolyGeometry.map((g) => (
          <g class={`atlas__glyph-pair atlas__glyph-pair--${g.kind}`} data-poly={g.data}>
            <polyline class="atlas__glyph-under" points={g.points} />
            <polyline class="atlas__glyph-line" points={g.points} />
          </g>
        ))}
        {glyphLineGeometry.map((g) => (
          <g
            class={`atlas__glyph-pair atlas__glyph-pair--${g.kind}`}
            data-ax={g.ax} data-ay={g.ay} data-az={g.az}
            data-bx={g.bx} data-by={g.by} data-bz={g.bz}
          >
            <line class="atlas__glyph-under" x1={g.x1} y1={g.y1} x2={g.x2} y2={g.y2} />
            <line class="atlas__glyph-line" x1={g.x1} y1={g.y1} x2={g.x2} y2={g.y2} />
          </g>
        ))}
      </g>

      <g class="atlas__clusters" data-atlas-clusters aria-hidden="true">
        {clusters.map((c) => (
          <text
            class="atlas__cluster"
            data-cluster={c.id}
            data-wx={c.wx} data-wy={c.wy} data-wz={c.wz}
            x={c.sx} y={c.sy}
            text-anchor="middle"
          >{c.label}</text>
        ))}
      </g>

      <g class="atlas__edges" data-atlas-edges aria-hidden="true">
        {edgeGeometry.map((e, i) => {
          const a = nodes.find((n) => n.id === e.a)!;
          const b = nodes.find((n) => n.id === e.b)!;
          const gradId = `atlas-edge-${i}`;
          return (
            <g class="atlas__edge-pair" data-edge-a={e.a} data-edge-b={e.b} data-edge-grad={gradId}>
              <defs>
                <linearGradient id={gradId} x1={a.sx} y1={a.sy} x2={b.sx} y2={b.sy} gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color={`rgba(${a.category === 'doctrine' ? '0,212,255' : a.category === 'substrate' ? '221,184,61' : a.category === 'discipline' ? '124,232,196' : '230,236,242'},0.6)`} />
                  <stop offset="100%" stop-color={`rgba(${b.category === 'doctrine' ? '0,212,255' : b.category === 'substrate' ? '221,184,61' : b.category === 'discipline' ? '124,232,196' : '230,236,242'},0.6)`} />
                </linearGradient>
              </defs>
              {/* Dark underlay so a 1px cyan line survives both the dark
                  sky and the bright ground of the diorama behind it. */}
              <line class="atlas__edge-under" x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} />
              <line class="atlas__edge" x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={`url(#${gradId})`} />
              {/* Light particle that travels along hot edges */}
              <circle class="atlas__edge-particle" r={1.8} cx={e.x1} cy={e.y1} />
            </g>
          );
        })}
      </g>

      <g class="atlas__nodes" data-atlas-nodes>
        {nodes.map((n) => {
          const isAxis = n.ring === 'axis';
          const coreGrad = isAxis
            ? 'url(#atlas-core-axis)'
            : `url(#atlas-core-${n.category})`;
          const haloGrad = isAxis
            ? 'url(#atlas-halo-axis)'
            : `url(#atlas-halo-${n.category})`;
          return (
            <a
              href={`#${n.id}`}
              class={`atlas__node atlas__node--${n.category}${isAxis ? ' atlas__node--axis' : ''}`}
              data-node={n.id}
              data-cat={n.category}
              data-cat-label={n.categoryLabel}
              data-term={n.termFull}
              data-def={n.def}
              data-num={n.num}
              data-degree={n.degree}
              data-wx={n.wx}
              data-wy={n.wy}
              data-wz={n.wz}
              data-ring={n.ring}
              aria-label={`${n.term} — ${n.categoryLabel}, ${n.degree} connections. Open entry.`}
              data-testid={`lexicon-node-${n.id}`}
            >
              <g class="atlas__node-tx" transform={`translate(${n.sx} ${n.sy}) scale(${n.s})`}>
                {/* Outer invisible hit zone */}
                <circle class="atlas__hit" r={n.r + 22} />
                {/* Deep shadow bed for contrast on any background */}
                <circle class="atlas__shade" r={n.r + 16} />
                {/* Soft glow halo — category-colored bloom */}
                <circle class="atlas__halo" r={n.r + 18} fill={haloGrad} />
                {/* Sonar pulse — animated on selection */}
                <circle class="atlas__sonar" r={n.r + 10} />
                {/* Outer energy ring — rotates on the axis node */}
                {isAxis && (
                  <circle class="atlas__energy-ring" r={n.r + 9} fill="none" />
                )}
                {/* Bright accent ring */}
                <circle class="atlas__ring" r={n.r + 5.5} fill="none" />
                {/* Inner luminous core — gradient-lit sphere */}
                <circle class="atlas__core" r={n.r} fill={coreGrad} />
                {/* Specular highlight — gives the dot a 3D sphere quality */}
                <circle class="atlas__spec" r={n.r * 0.4} cx={-n.r * 0.25} cy={-n.r * 0.25} />
                {/* Label */}
                <text class="atlas__label" y={n.r + 24} text-anchor="middle">{n.term}</text>
              </g>
            </a>
          );
        })}
      </g>
    </svg>

    <div class="atlas__tip" data-atlas-tip hidden aria-hidden="true">
      <p class="atlas__tip-meta">
        <span data-atlas-tip-num></span>
        <span data-atlas-tip-cat></span>
      </p>
      <p class="atlas__tip-term" data-atlas-tip-term></p>
      <p class="atlas__tip-def" data-atlas-tip-def></p>
      <p class="atlas__tip-action">Select to open entry</p>
    </div>

    <aside class="atlas__inspector" data-atlas-inspector hidden aria-label="Term entry" data-testid="atlas-inspector">
      <div class="atlas__inspector-chrome">
        <p class="atlas__trail" data-atlas-trail data-testid="atlas-trail" aria-label="Traversal trail"></p>
        <button
          type="button"
          class="atlas__inspector-close"
          data-atlas-close
          aria-label="Close entry and return to the full field"
          data-testid="atlas-inspector-close"
        >
          <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true" focusable="false">
            <path d="M3 3 L11 11 M11 3 L3 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div class="atlas__cards" data-atlas-cards>
        {cards.map((c) => (
          <article class="atlas-card" data-atlas-card={c.id} hidden>
            <p class="atlas-card__meta">
              <span class="atlas-card__num">L-{c.num}</span>
              <span class="atlas-card__cat" data-cat={c.categoryId}>{c.category}</span>
              <span class={`atlas-card__status atlas-card__status--${c.status}`}>
                {c.status === 'active' ? 'Active' : 'Deprecated'}
              </span>
              <span class="atlas-card__degree">{c.degree} links</span>
            </p>

            <h3 class="atlas-card__term" data-testid={`atlas-card-term-${c.id}`}>{c.term}</h3>

            {c.aka.length > 0 && (
              <p class="atlas-card__aka">
                <span class="atlas-card__aka-label">AKA</span>
                {c.aka.join(' · ')}
              </p>
            )}

            <p class="atlas-card__def">{c.definition}</p>

            {c.related.length > 0 && (
              <section class="atlas-card__edges">
                <h4 class="atlas-card__edges-label">Traverse</h4>
                <ul class="atlas-card__chips" role="list">
                  {c.related.map((r) => (
                    <li>
                      <button
                        type="button"
                        class="atlas-card__chip"
                        data-atlas-goto={r.id}
                        data-testid={`atlas-goto-${r.id}`}
                      >{r.label}</button>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {c.incoming.length > 0 && (
              <section class="atlas-card__edges">
                <h4 class="atlas-card__edges-label">Referenced by</h4>
                <ul class="atlas-card__chips" role="list">
                  {c.incoming.map((r) => (
                    <li>
                      <button
                        type="button"
                        class="atlas-card__chip atlas-card__chip--muted"
                        data-atlas-goto={r.id}
                      >{r.label}</button>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <section class="atlas-card__edges atlas-card__provenance">
              <h4 class="atlas-card__edges-label">Used in</h4>
              {c.usage.total === 0 ? (
                <p class="atlas-card__void">Not yet cited in the published corpus.</p>
              ) : (
                <ul class="atlas-card__uses" role="list">
                  {c.usage.praxis.map((u) => (
                    <li>
                      <a
                        class="atlas-card__use"
                        href={u.href}
                        data-testid={`atlas-use-praxis-${u.id}`}
                      >
                        <span class="atlas-card__use-kind">Praxis</span>
                        <span class="atlas-card__use-title">{u.title}</span>
                        <span class="atlas-card__use-hits">{u.hits}×</span>
                      </a>
                    </li>
                  ))}
                  {c.usage.engagements.map((u) => (
                    <li>
                      <a
                        class="atlas-card__use atlas-card__use--engagement"
                        href={u.href}
                        data-testid={`atlas-use-engagement-${u.id}`}
                      >
                        <span class="atlas-card__use-kind">Exhibit</span>
                        <span class="atlas-card__use-title">{u.title}</span>
                        <span class="atlas-card__use-hits">{u.hits}×</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            <footer class="atlas-card__foot">
              <button
                type="button"
                class="atlas-card__action"
                data-lex-copy-cite
                data-cite={c.citation}
                aria-label={`Copy citation for ${c.term}`}
              >Copy citation</button>
              <button
                type="button"
                class="atlas-card__action"
                data-lex-copy-link
                data-href={c.permalink}
                aria-label={`Copy permalink for ${c.term}`}
              >Copy link</button>
              {c.revised && <span class="atlas-card__revised">Revised {c.revised}</span>}
            </footer>
          </article>
        ))}
      </div>
    </aside>

    <p class="atlas__void" data-atlas-void hidden>No terms match the current filter.</p>

    <p class="atlas__legend-note" aria-hidden="true">
      <span data-atlas-keys>Drag orbit · scroll zoom · ↑↓←→ walk edges · F focus · Esc release</span>
    </p>
  </div>
</section>

<style>
  .atlas {
    /* Channel colours — cyan/gold house palette plus instrument-green
       and mist so four bins stay separable inside the lab register.
       Colour is never the only encoding: channel chips, node
       aria-labels and inspector meta all carry the label in text. */
    --cat-doctrine: var(--cyan-core);
    --cat-doctrine-rgb: 0, 212, 255;
    --cat-substrate: var(--gold-bright);
    --cat-substrate-rgb: 221, 184, 61;
    --cat-discipline: #7ce8c4;
    --cat-discipline-rgb: 124, 232, 196;
    --cat-engagement: #e6ecf2;
    --cat-engagement-rgb: 230, 236, 242;
    --cat-uncategorized: #9aa7b4;
    --cat-uncategorized-rgb: 154, 167, 180;

    /* No frost panel: the diorama behind the page is this section's
       sky. Only a hairline top rule anchors it to the layout. */
    width: min(1440px, 100% - clamp(24px, 5vw, 64px));
    margin-inline: auto;
    margin-bottom: clamp(28px, 4vw, 56px);
    scroll-margin-top: 96px;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vw, 22px);
  }

  /* ── Header bar (title + metadata readout, inside backdrop) ── */
  .atlas__bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: clamp(18px, 3vw, 40px);
    flex-wrap: wrap;
    padding-bottom: 12px;
    margin-bottom: 4px;
    border-bottom: 1px solid rgba(0, 212, 255, 0.12);
  }

  .atlas__eyebrow {
    margin: 0 0 6px;
    color: var(--cyan-core);
    text-shadow: 0 1px 6px rgba(2, 8, 14, 0.9);
  }

  .atlas__heading {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    text-shadow: 0 2px 18px rgba(6, 14, 22, 0.6), var(--cyan-glow-text);
  }

  .atlas__hint {
    margin: 8px 0 0;
    max-width: 62ch;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-secondary);
    text-shadow: 0 1px 6px rgba(2, 8, 14, 0.9);
  }

  /* ── Readout strip (metadata + live state) ───────────────────── */
  .atlas__readout {
    display: flex;
    gap: 16px;
    margin: 0;
    flex-wrap: wrap;
  }

  .atlas__readout-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-left: 12px;
    border-left: 1px solid rgba(0, 212, 255, 0.24);
  }

  .atlas__readout dt,
  .atlas__readout dd {
    text-shadow: 0 1px 5px rgba(2, 8, 14, 0.95);
  }

  .atlas__readout dt {
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(221, 184, 61, 0.82);
  }

  .atlas__readout dd {
    margin: 0;
    font-family: var(--font-ticker);
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan-bright);
    white-space: nowrap;
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1100px) {
    .atlas__readout { gap: 10px; }
    .atlas__readout-cell { padding-left: 8px; }
  }

  /* ── Backdrop (header + interaction controls) ───────────────── */
  .atlas__controls {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: -48px;
    padding: 14px 12px 22px;
    background: linear-gradient(
      180deg,
      rgba(2, 9, 16, 0.72) 0%,
      rgba(2, 9, 16, 0.48) 50%,
      rgba(2, 9, 16, 0) 100%
    );
    border-top: 1px solid rgba(0, 212, 255, 0.1);
    pointer-events: none;
  }

  .atlas__controls > * {
    pointer-events: auto;
  }

  .atlas__interaction {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 8px 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .atlas__interaction::-webkit-scrollbar { display: none; }

  @media (max-width: 900px) {
    .atlas__controls {
      margin-bottom: -36px;
      padding-bottom: 18px;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .atlas__controls {
      background: rgba(3, 10, 17, 0.96);
    }
  }

  .atlas__search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    min-height: 38px;
    flex: 0 1 340px;
    min-width: 220px;
    border: 1px solid rgba(0, 212, 255, 0.25);
    background: rgba(3, 12, 20, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    clip-path: var(--clip-sm);
  }

  .atlas__search:focus-within {
    border-color: rgba(0, 212, 255, 0.6);
    box-shadow: 0 0 0 2px rgba(0, 212, 255, 0.15);
  }

  .atlas__search-label {
    display: inline-flex;
    align-items: center;
    color: var(--cyan-core);
  }

  .atlas__search-input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .atlas__search-input::placeholder {
    color: var(--text-muted);
    opacity: 0.65;
  }

  .atlas__search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  @media (pointer: coarse) {
    .atlas__search { min-height: 44px; }
    .atlas__search-input { font-size: 16px; }
  }

  .atlas__count,
  .atlas__chip-count {
    text-shadow: 0 1px 5px rgba(2, 8, 14, 0.9);
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .atlas__channels {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .atlas__chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .atlas__chip-dot[data-cat='doctrine'] { background: var(--cat-doctrine); box-shadow: 0 0 7px rgba(var(--cat-doctrine-rgb), 0.8); }
  .atlas__chip-dot[data-cat='substrate'] { background: var(--cat-substrate); box-shadow: 0 0 7px rgba(var(--cat-substrate-rgb), 0.8); }
  .atlas__chip-dot[data-cat='discipline'] { background: var(--cat-discipline); box-shadow: 0 0 7px rgba(var(--cat-discipline-rgb), 0.8); }
  .atlas__chip-dot[data-cat='engagement'] { background: var(--cat-engagement); box-shadow: 0 0 7px rgba(var(--cat-engagement-rgb), 0.8); }
  .atlas__chip-dot[data-cat='uncategorized'] { background: var(--cat-uncategorized); }

  .atlas__view {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }

  .atlas__view-btn {
    min-width: 32px;
    min-height: 32px;
    padding: 0 8px;
    font-family: var(--font-ticker);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan-core);
    border: 1px solid rgba(0, 212, 255, 0.28);
    background: rgba(3, 12, 20, 0.5);
    clip-path: var(--clip-sm);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .atlas__view-btn--wide { padding: 0 12px; }

  .atlas__view-btn:hover {
    color: var(--cyan-bright);
    border-color: rgba(0, 212, 255, 0.6);
    background: rgba(0, 212, 255, 0.12);
    transform: translateY(-1px);
  }

  .atlas__view-btn:focus-visible {
    outline: 2px solid var(--cyan-bright);
    outline-offset: 2px;
  }

  .atlas__view-btn[aria-pressed='true'] {
    color: var(--gold-bright);
    border-color: rgba(221, 184, 61, 0.65);
    background: rgba(221, 184, 61, 0.14);
  }

  @media (pointer: coarse) {
    .atlas__view-btn { min-width: 44px; min-height: 44px; }
  }

  /* ── Stage ───────────────────────────────────────────────────── */
  .atlas__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1000 / 625;
    max-height: clamp(420px, 64vh, 680px);
    border: 1px solid rgba(0, 212, 255, 0.14);
    background:
      radial-gradient(ellipse at 50% 38%, rgba(0, 30, 60, 0.22) 0%, rgba(2, 9, 16, 0.5) 45%, rgba(1, 6, 11, 0.82) 100%);
    backdrop-filter: blur(4px) saturate(0.92) brightness(0.52);
    -webkit-backdrop-filter: blur(4px) saturate(0.92) brightness(0.52);
    box-shadow:
      inset 0 1px 0 rgba(0, 212, 255, 0.1),
      inset 0 0 140px rgba(0, 212, 255, 0.04),
      inset 0 0 60px rgba(0, 80, 140, 0.06);
    clip-path: var(--clip-card);
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    perspective: 1400px;
  }

  /* Deep-space nebula glow */
  .atlas__nebula {
    pointer-events: none;
  }

  .atlas__scrim {
    animation: atlasScrimBreathe 8s ease-in-out infinite;
  }

  /* Readers who ask for reduced transparency get an opaque bed behind
     the field instead of the see-through diorama. */
  @media (prefers-reduced-transparency: reduce) {
    .atlas__stage {
      background: rgba(3, 10, 17, 0.97);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .atlas__scrim {
      display: none;
    }
  }

  .atlas__stage[data-dragging='true'] { cursor: grabbing; }

  .atlas__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Sacred-geometry armature ────────────────────────────────── */
  .atlas__glyph-line,
  .atlas__glyph-under {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: miter;
  }

  .atlas__glyph-under {
    stroke: rgba(2, 9, 15, 0.3);
    stroke-width: 2;
  }

  .atlas__glyph-line {
    stroke: rgba(130, 240, 255, 0.5);
    stroke-width: 1;
    animation: atlasGlyphBreathe 7s ease-in-out infinite;
  }

  .atlas__glyph-pair--core .atlas__glyph-line {
    stroke: rgba(240, 205, 92, 0.55);
    stroke-width: 1.2;
    filter: drop-shadow(0 0 3px rgba(240, 205, 92, 0.3));
  }

  .atlas__glyph-pair--ring .atlas__glyph-line {
    stroke: rgba(130, 240, 255, 0.55);
    filter: drop-shadow(0 0 2px rgba(0, 212, 255, 0.2));
  }

  .atlas__glyph-pair--star .atlas__glyph-line {
    stroke: rgba(120, 236, 255, 0.3);
    stroke-dasharray: 3 7;
  }

  .atlas__glyph-pair--outer .atlas__glyph-line {
    stroke: rgba(130, 240, 255, 0.35);
  }

  .atlas__glyph-pair--spoke .atlas__glyph-line {
    stroke: rgba(120, 236, 255, 0.18);
  }

  .atlas__glyph-pair--octagram .atlas__glyph-line {
    stroke: rgba(240, 205, 92, 0.35);
    filter: drop-shadow(0 0 2px rgba(240, 205, 92, 0.15));
  }

  .atlas__glyph-pair--spoke .atlas__glyph-under,
  .atlas__glyph-pair--star .atlas__glyph-under,
  .atlas__glyph-pair--octagram .atlas__glyph-under {
    stroke-width: 1.6;
    stroke: rgba(2, 9, 15, 0.22);
  }

  /* The armature recedes while a term holds the field. */
  .atlas__glyph {
    transition: opacity 0.4s ease;
  }

  [data-atlas][data-selected] .atlas__glyph,
  [data-atlas][data-focus] .atlas__glyph {
    opacity: 0.35;
  }

  /* Channel signage is contextual, not permanent: a caption lights when
     its channel is filtered, hovered on the chip, or holds the selected
     term. Always-on captions collide with term labels at this density. */
  .atlas__cluster {
    opacity: 0;
    transition: opacity 0.3s ease;
    fill: rgba(236, 200, 84, 0.72);
    font-family: var(--font-ticker);
    font-size: 13px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    paint-order: stroke;
    stroke: rgba(2, 8, 14, 0.85);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .atlas__cluster.is-live { opacity: 1; }

  /* ── Edges ───────────────────────────────────────────────────── */
  .atlas__edge {
    stroke: rgba(96, 226, 255, 0.55);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: stroke 0.3s ease, stroke-width 0.3s ease;
  }

  .atlas__edge-under {
    stroke: rgba(2, 9, 15, 0.6);
    stroke-width: 3.4;
    vector-effect: non-scaling-stroke;
  }

  .atlas__edge-particle {
    fill: rgba(180, 250, 255, 0.9);
    filter: drop-shadow(0 0 3px rgba(120, 244, 255, 0.8));
    opacity: 0;
    pointer-events: none;
    vector-effect: non-scaling-stroke;
  }

  .atlas__edge-pair {
    transition: opacity 0.3s ease;
  }

  [data-atlas][data-focus] .atlas__edge-pair,
  [data-atlas][data-selected] .atlas__edge-pair { opacity: 0.08; }

  [data-atlas][data-focus] .atlas__edge-pair.is-hot,
  [data-atlas][data-selected] .atlas__edge-pair.is-hot { opacity: 1; }

  [data-atlas][data-focus] .atlas__edge-pair.is-hot .atlas__edge,
  [data-atlas][data-selected] .atlas__edge-pair.is-hot .atlas__edge {
    stroke: rgba(120, 244, 255, 0.95);
    stroke-width: 1.8;
    stroke-dasharray: 5 9;
    filter: url(#atlas-edge-glow);
    animation: atlasFlow 1.1s linear infinite;
  }

  [data-atlas][data-focus] .atlas__edge-pair.is-hot .atlas__edge-particle,
  [data-atlas][data-selected] .atlas__edge-pair.is-hot .atlas__edge-particle {
    opacity: 1;
  }

  .atlas__edge-pair.is-dim { opacity: 0 !important; }

  @keyframes atlasFlow {
    from { stroke-dashoffset: 28; }
    to { stroke-dashoffset: 0; }
  }

  /* ── Premium motion keyframes ─────────────────────────────────── */

  /* Tooltip materializes with a soft fade */
  @keyframes atlasTipIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Inspector card content rises into place when switching terms */
  @keyframes atlasCardIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Armature breathing — the sacred geometry inhales and exhales */
  @keyframes atlasGlyphBreathe {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.68; }
  }

  /* Scrim breathes — the atmospheric bloom pulses gently */
  @keyframes atlasScrimBreathe {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.82; }
  }

  /* Axis energy ring pulses in brightness as it spins */
  @keyframes atlasEnergyPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.85; }
  }

  /* ── Nodes ───────────────────────────────────────────────────── */
  .atlas__node {
    outline: none;
    cursor: pointer;
    --node-c: var(--cat-uncategorized);
    --node-rgb: var(--cat-uncategorized-rgb);
    transition: opacity 0.35s ease;
  }

  .atlas__node--doctrine { --node-c: var(--cat-doctrine); --node-rgb: var(--cat-doctrine-rgb); }
  .atlas__node--substrate { --node-c: var(--cat-substrate); --node-rgb: var(--cat-substrate-rgb); }
  .atlas__node--discipline { --node-c: var(--cat-discipline); --node-rgb: var(--cat-discipline-rgb); }
  .atlas__node--engagement { --node-c: var(--cat-engagement); --node-rgb: var(--cat-engagement-rgb); }

  /* Invisible touch/pointer target — the visible dot is intentionally
     small at constellation density; the hit area is not. */
  .atlas__hit {
    fill: transparent;
  }

  /* Local contrast bed: on the bright terraced ground this reads as the
     node's own shadow, on the dark sky it disappears. */
  .atlas__shade {
    fill: rgba(2, 9, 15, 0.55);
    filter: blur(2px);
  }

  /* Soft glow halo — category-colored bloom, lit from within */
  .atlas__halo {
    transition: opacity 0.3s ease;
  }

  .atlas__ring {
    fill: none;
    stroke: rgba(var(--node-rgb), 0.42);
    stroke-width: 1;
    transition: stroke 0.3s ease, stroke-width 0.3s ease;
  }

  /* Luminous gradient-filled core — the "lit sphere" */
  .atlas__core {
    transition: filter 0.3s ease;
  }

  /* Specular highlight — gives the core a 3D orb quality */
  .atlas__spec {
    fill: rgba(255, 255, 255, 0.35);
    filter: blur(1px);
    pointer-events: none;
  }

  .atlas__label {
    fill: rgba(240, 246, 250, 0.95);
    font-family: var(--font-ticker);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: fill 0.3s ease;
    paint-order: stroke;
    stroke: rgba(2, 8, 14, 0.92);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .atlas__sonar {
    fill: none;
    stroke: rgba(var(--node-rgb), 0.55);
    stroke-width: 1;
    opacity: 0;
  }

  /* Rotating energy ring — only on the axis node */
  .atlas__energy-ring {
    stroke: rgba(240, 205, 92, 0.5);
    stroke-width: 1;
    stroke-dasharray: 4 8;
    transform-origin: center;
    animation: atlasEnergySpin 18s linear infinite, atlasEnergyPulse 4s ease-in-out infinite;
  }

  @keyframes atlasEnergySpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Axis node always gets the bloom filter for a premium centerpiece */
  .atlas__node--axis .atlas__core {
    filter: url(#atlas-bloom);
  }

  .atlas__node--axis .atlas__ring {
    stroke: rgba(240, 205, 92, 0.6);
    stroke-width: 1.4;
  }

  .atlas__node.is-origin .atlas__sonar {
    animation: atlasSonar 2.6s cubic-bezier(0.22, 0.9, 0.3, 1) infinite;
  }

  @keyframes atlasSonar {
    0% { opacity: 0.75; transform: scale(0.7); }
    70% { opacity: 0; transform: scale(2.8); }
    100% { opacity: 0; transform: scale(2.8); }
  }

  /* Selected node gets the hot bloom filter */
  .atlas__node.is-origin .atlas__core {
    filter: url(#atlas-bloom-hot);
  }

  .atlas__node:hover .atlas__halo,
  .atlas__node:focus-visible .atlas__halo,
  .atlas__node.is-origin .atlas__halo,
  .atlas__node.is-hot .atlas__halo { opacity: 1; }

  .atlas__node:hover .atlas__ring,
  .atlas__node:focus-visible .atlas__ring,
  .atlas__node.is-origin .atlas__ring,
  .atlas__node.is-hot .atlas__ring { stroke: rgba(var(--node-rgb), 0.95); stroke-width: 1.6; }

  .atlas__node:hover .atlas__core,
  .atlas__node:focus-visible .atlas__core,
  .atlas__node.is-hot .atlas__core { filter: url(#atlas-bloom); }

  .atlas__node:hover .atlas__label,
  .atlas__node:focus-visible .atlas__label,
  .atlas__node.is-hot .atlas__label { fill: var(--text-primary); }

  .atlas__node:focus-visible .atlas__ring { stroke-width: 2.4; }

  [data-atlas][data-selected] .atlas__node:not(.is-hot),
  [data-atlas][data-focus] .atlas__node:not(.is-hot) { opacity: 0.16; }

  .atlas__node.is-out { opacity: 0 !important; pointer-events: none; }

  /* Inspector card content rises into place when a new term is opened */
  .atlas-card:not([hidden]) {
    animation: atlasCardIn 0.42s cubic-bezier(0.16, 0.84, 0.24, 1) both;
  }

  /* ── Hover tip ───────────────────────────────────────────────── */
  .atlas__tip {
    position: absolute;
    z-index: 4;
    max-width: 290px;
    padding: 11px 13px;
    background: rgba(4, 12, 18, 0.9);
    border: 1px solid rgba(0, 212, 255, 0.28);
    clip-path: var(--clip-sm);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 14px));
    animation: atlasTipIn 0.2s ease-out both;
  }

  .atlas__tip-meta {
    display: flex;
    gap: 10px;
    margin: 0 0 4px;
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan-core);
  }

  .atlas__tip-term {
    margin: 0 0 6px;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .atlas__tip-def {
    margin: 0 0 6px;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .atlas__tip-action {
    margin: 0;
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-bright);
  }

  /* ── Inspector ───────────────────────────────────────────────── */
  .atlas__inspector {
    position: absolute;
    z-index: 5;
    top: clamp(12px, 2%, 22px);
    right: clamp(12px, 2%, 22px);
    bottom: clamp(12px, 2%, 22px);
    width: min(400px, 42%);
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px 16px;
    background: linear-gradient(170deg, rgba(9, 22, 32, 0.9) 0%, rgba(4, 12, 20, 0.94) 100%);
    border: 1px solid rgba(0, 212, 255, 0.34);
    box-shadow:
      inset 0 1px 0 rgba(0, 212, 255, 0.18),
      0 26px 70px rgba(1, 7, 13, 0.7),
      0 0 40px rgba(0, 212, 255, 0.08);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    clip-path: var(--clip-card);
    overflow: hidden auto;
    scrollbar-width: thin;
    transform-origin: right center;
    animation: atlasInspectorIn 0.62s cubic-bezier(0.16, 0.84, 0.24, 1) both;
  }

  .atlas__inspector[hidden] { display: none; }

  @keyframes atlasInspectorIn {
    from {
      opacity: 0;
      transform: perspective(1200px) translate3d(46px, 0, -140px) rotateY(-14deg);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: perspective(1200px) translate3d(0, 0, 0) rotateY(0deg);
      filter: blur(0);
    }
  }

  .atlas__inspector-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0, 212, 255, 0.16);
  }

  .atlas__trail {
    margin: 0;
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .atlas__inspector-close {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan-core);
    border: 1px solid rgba(0, 212, 255, 0.3);
    background: rgba(0, 212, 255, 0.06);
    clip-path: var(--clip-sm);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, transform 0.2s ease;
  }

  .atlas__inspector-close:hover {
    color: var(--cyan-bright);
    border-color: rgba(0, 212, 255, 0.65);
    background: rgba(0, 212, 255, 0.14);
    transform: rotate(90deg);
  }

  .atlas__inspector-close:focus-visible {
    outline: 2px solid var(--cyan-bright);
    outline-offset: 2px;
  }

  @media (pointer: coarse) {
    .atlas__inspector-close { width: 40px; height: 40px; }
  }

  .atlas-card[hidden] { display: none; }

  .atlas-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Staggered reveal — each block arrives after the panel lands. */
  .atlas-card > * {
    animation: atlasCardIn 0.5s cubic-bezier(0.18, 0.82, 0.26, 1) both;
  }
  .atlas-card > *:nth-child(1) { animation-delay: 0.12s; }
  .atlas-card > *:nth-child(2) { animation-delay: 0.18s; }
  .atlas-card > *:nth-child(3) { animation-delay: 0.24s; }
  .atlas-card > *:nth-child(4) { animation-delay: 0.3s; }
  .atlas-card > *:nth-child(5) { animation-delay: 0.36s; }
  .atlas-card > *:nth-child(6) { animation-delay: 0.42s; }
  .atlas-card > *:nth-child(7) { animation-delay: 0.48s; }
  .atlas-card > *:nth-child(8) { animation-delay: 0.54s; }
  .atlas-card > *:nth-child(9) { animation-delay: 0.6s; }

  @keyframes atlasCardIn {
    from { opacity: 0; transform: translate3d(14px, 0, 0); }
    to { opacity: 1; transform: none; }
  }

  .atlas-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .atlas-card__num { color: rgba(221, 184, 61, 0.9); }

  .atlas-card__cat {
    padding: 2px 7px;
    color: var(--cyan-bright);
    border: 1px solid rgba(0, 212, 255, 0.3);
    background: rgba(0, 212, 255, 0.06);
    clip-path: var(--clip-sm);
  }

  .atlas-card__status--active { color: rgba(112, 210, 160, 0.95); }
  .atlas-card__status--deprecated { color: rgba(248, 180, 130, 0.95); }

  .atlas-card__term {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.28;
    text-transform: uppercase;
    color: var(--cyan-bright);
    text-shadow: var(--cyan-glow-text);
    overflow-wrap: anywhere;
  }

  .atlas-card__aka {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .atlas-card__aka-label {
    margin-right: 8px;
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    color: rgba(221, 184, 61, 0.8);
  }

  .atlas-card__def {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .atlas-card__edges {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid rgba(0, 212, 255, 0.14);
  }

  .atlas-card__edges-label {
    margin: 0;
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(221, 184, 61, 0.8);
  }

  .atlas-card__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .atlas-card__chip {
    font-family: var(--font-heading);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 10px;
    color: var(--cyan-core);
    border: 1px solid rgba(0, 212, 255, 0.3);
    background: rgba(0, 212, 255, 0.06);
    clip-path: var(--clip-sm);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, transform 0.18s ease;
  }

  .atlas-card__chip:hover {
    color: var(--cyan-bright);
    border-color: rgba(0, 212, 255, 0.66);
    background: rgba(0, 212, 255, 0.14);
    transform: translateY(-1px);
  }

  .atlas-card__chip:focus-visible {
    outline: 2px solid var(--cyan-bright);
    outline-offset: 2px;
  }

  .atlas-card__chip--muted {
    color: var(--text-secondary);
    border-color: rgba(200, 196, 190, 0.22);
    background: rgba(200, 196, 190, 0.04);
  }

  @media (pointer: coarse) {
    .atlas-card__chip { padding: 10px 13px; }
  }

  /* ── Provenance ("Used in") ──────────────────────────────────── */
  .atlas-card__uses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .atlas-card__use {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 10px;
    padding: 7px 9px;
    text-decoration: none;
    border: 1px solid rgba(200, 196, 190, 0.14);
    border-left: 2px solid rgba(0, 212, 255, 0.45);
    background: rgba(0, 212, 255, 0.03);
    transition: border-color 0.16s ease, background 0.16s ease, transform 0.18s ease;
  }

  .atlas-card__use--engagement {
    border-left-color: rgba(221, 184, 61, 0.5);
  }

  .atlas-card__use:hover {
    border-color: rgba(0, 212, 255, 0.4);
    background: rgba(0, 212, 255, 0.09);
    transform: translateX(2px);
  }

  .atlas-card__use:focus-visible {
    outline: 2px solid var(--cyan-bright);
    outline-offset: 2px;
  }

  .atlas-card__use-kind {
    font-family: var(--font-ticker);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .atlas-card__use--engagement .atlas-card__use-kind {
    color: rgba(221, 184, 61, 0.78);
  }

  .atlas-card__use-title {
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .atlas-card__use:hover .atlas-card__use-title {
    color: var(--text-primary);
  }

  .atlas-card__use-hits {
    font-family: var(--font-ticker);
    font-size: 9px;
    letter-spacing: 0.12em;
    color: rgba(0, 212, 255, 0.6);
  }

  .atlas-card__void {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .atlas-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(0, 212, 255, 0.14);
  }

  .atlas-card__action {
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 9px;
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid rgba(200, 196, 190, 0.2);
    background: rgba(200, 196, 190, 0.03);
    clip-path: var(--clip-sm);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .atlas-card__action:hover {
    color: var(--cyan-bright);
    border-color: rgba(0, 212, 255, 0.45);
    background: rgba(0, 212, 255, 0.08);
  }

  .atlas-card__action[data-state='copied'] {
    color: var(--gold-bright);
    border-color: rgba(221, 184, 61, 0.55);
  }

  .atlas-card__action:focus-visible {
    outline: 2px solid var(--cyan-bright);
    outline-offset: 2px;
  }

  .atlas-card__revised {
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-left: auto;
  }

  /* ── Void state + key hints ──────────────────────────────────── */
  .atlas__void {
    text-shadow: 0 1px 4px rgba(2, 8, 14, 0.95);
    position: absolute;
    inset: auto 0 50% 0;
    margin: 0;
    text-align: center;
    font-family: var(--font-ticker);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .atlas__void[hidden] { display: none; }

  .atlas__legend-note {
    position: absolute;
    left: 14px;
    bottom: 10px;
    margin: 0;
    font-family: var(--font-ticker);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(220, 228, 235, 0.7);
    text-shadow: 0 1px 4px rgba(2, 8, 14, 0.95), 0 0 12px rgba(2, 8, 14, 0.8);
    pointer-events: none;
  }

  /* Phones: the field reads as a constellation of dots you tap — every
     label at once would be an illegible mat at this scale, so labels
     belong to whatever is touched or selected. */
  @media (max-width: 600px) {
    .atlas__label {
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .atlas__node.is-hot .atlas__label,
    .atlas__node:focus-visible .atlas__label {
      opacity: 1;
    }
  }

  /* ── Mobile: inspector becomes a bottom sheet ────────────────── */
  @media (max-width: 900px) {
    .atlas__stage {
      aspect-ratio: 4 / 5;
      max-height: none;
    }
    .atlas__inspector {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      max-height: 52%;
      clip-path: none;
      border-inline: 0;
      border-bottom: 0;
      transform-origin: bottom center;
      animation-name: atlasSheetIn;
    }
